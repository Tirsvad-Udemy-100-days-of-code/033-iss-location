# Settings of the ISS Overhead Notifier.
# Copy this file to config.env and replace every placeholder. config.env is
# ignored by git: never commit real values. A variable that is also set in the
# real environment overrides the value here.

# Your position in degrees (latitude -90 to 90, longitude -180 to 180).
ISS_NOTIFIER_LATITUDE=<your latitude>
ISS_NOTIFIER_LONGITUDE=<your longitude>

# Your SMTP server. The port is optional (default 587, STARTTLS).
ISS_NOTIFIER_SMTP_HOST=smtp.example.com
ISS_NOTIFIER_SMTP_PORT=587
ISS_NOTIFIER_SMTP_USER=<your login>
# Use an app password from your mail provider, not your normal password.
ISS_NOTIFIER_SMTP_PASSWORD=<your app password>

# The address that receives the e-mail.
ISS_NOTIFIER_MAIL_TO=<recipient address>
