# Doxyfile for the ISS Overhead Notifier. Run from the repository root:
#   doxygen Doxyfile
# HTML output goes to build/doxygen (ignored by git).
PROJECT_NAME           = "ISS Overhead Notifier"
PROJECT_BRIEF          = "E-mail when the International Space Station is overhead at night"
OUTPUT_DIRECTORY       = build
INPUT                  = src
FILE_PATTERNS          = *.py
RECURSIVE              = YES
OPTIMIZE_OUTPUT_JAVA   = YES
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
JAVADOC_AUTOBRIEF      = YES
AUTOLINK_SUPPORT       = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
GENERATE_HTML          = YES
HTML_OUTPUT            = doxygen
GENERATE_LATEX         = NO
HAVE_DOT               = NO
QUIET                  = YES
